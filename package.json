{
  "name": "expo-screenshot-guard",
  "version": "0.1.0",
  "description": "Per-screen screenshot and screen recording protection for Expo apps.",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "engines": {
    "node": "*",
    "npm": "*",
    "yarn": "please-use-npm",
    "pnpm": "please-use-npm",
    "bun": "please-use-npm",
    "deno": "please-use-npm"
  },
  "scripts": {
    "build": "expo-module build",
    "clean": "expo-module clean",
    "format": "prettier src/ --write",
    "lint": "expo-module lint",
    "typecheck": "expo-module tsc --noEmit",
    "test": "CI=true expo-module test",
    "prepare": "expo-module prepare && husky",
    "prepublishOnly": "expo-module prepublishOnly",
    "expo-module": "expo-module",
    "open:ios": "xed example/ios",
    "open:android": "open -a \"Android Studio\" example/android"
  },
  "keywords": [
    "react-native",
    "expo",
    "expo-screenshot-guard",
    "ExpoScreenshotGuard"
  ],
  "repository": "https://github.com/GrzywN/expo-screenshot-guard",
  "bugs": {
    "url": "https://github.com/GrzywN/expo-screenshot-guard/issues"
  },
  "author": "Karol Binkowski <karolbinkowski3@proton.me> (GrzywN)",
  "license": "MIT",
  "homepage": "https://github.com/GrzywN/expo-screenshot-guard#readme",
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@types/react": "19.2.14",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-react-native": "5.0.0",
    "expo": "55.0.5",
    "expo-module-scripts": "55.0.2",
    "globals": "17.4.0",
    "husky": "9.1.7",
    "lint-staged": "16.3.2",
    "prettier": "3.8.1",
    "react-native": "0.84.1",
    "typescript-eslint": "8.56.1"
  },
  "peerDependencies": {
    "expo": "*",
    "react": "*",
    "react-native": "*"
  }
}
